from tb_livro;

select* from vwEX2;

-- 3	Criar uma View – list isbn, titulo e editora
create view vwEX3 as 
select isbn, titulo, editora
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora;

select* from vwEX3;

-- 4	Criar uma View – list isbn, titulo e gênero por ordem de gênero.

create view vwEX04 as 
select isbn, titulo, genero
from tb_livro L inner join tb_genero G
on L.cd_genero = G.cd_genero; 

select * from vwEX04 order by genero;
