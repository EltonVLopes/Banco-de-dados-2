-- inner join e view

use bd_livro_0302;

-- join
-- lista isbn, titulo, editora
select L.isbn, L.titulo, E.editora from
tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora;

-- produto cartesiano - algebra relacional
select L.isbn, L.titulo, E.editora from
tb_livro L inner join tb_editora E;

-- join
-- isbn, titulo, editora e genero

select isbn, titulo, editora, genero
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora
inner join tb_genero G
on L.cd_genero = G.cd_genero;

-- Exercicios

-- 1	Lista titulo, editora quando o preco maior que R$200,00
select isbn, titulo, editora, preco
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora
where L.preco > 200;

-- 2	Lista titulo, gênero quando o preco entre R$200,00 e R$300,00

select L.isbn, L.titulo, G.genero, L.preco
from tb_livro L inner join tb_genero G
on L.cd_genero = G.cd_genero
where L.preco >= 200 and L.preco <= 300;
-- poderia usar between(200 and 300)

-- 3	Lista  titulo, editora e gênero quando cd_editora 1, 2 e 3
select L.isbn,L.titulo, E.editora, G.genero, L.cd_editora
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora
inner join tb_genero G
on L.cd_genero = G.cd_genero
where L.cd_editora in(1, 2, 3);


-- 4	lista titulo, editora, preco e preco com mais 20%
select L.isbn, L.titulo, E.editora, L.preco, L.preco * 1.2 as vinte
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora;

-- view

create view vw01 as 
select L.isbn, L.titulo, E.editora, L.preco, L.preco * 1.2 as vinte
from tb_livro L inner join tb_editora E
on L.cd_editora = E.cd_editora;

select* from vw01;

